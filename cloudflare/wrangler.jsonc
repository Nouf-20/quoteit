{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quoteit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quoteit-db",
      "database_id": "7243cbec-b4ef-4479-b7fb-f730e5bbb94d"
    }
  ]
}
